{
  "compilerOptions": {
    "tsBuildInfoFile": "/dev/null",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "build"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}